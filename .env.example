# ============================================================================
# VoiceFlow-AI Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env - it is in .gitignore for DSGVO compliance
# ============================================================================

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/voiceflow

# API Server
PORT=8080
API_BASE_URL=http://localhost:8080

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080

# Vapi.ai (Required)
VAPI_API_KEY=
VAPI_WEBHOOK_SECRET=

# Telnyx (Required)
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
TELNYX_SENDER_NUMBER=+491234567890

# Stripe (Required)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PROFESSIONAL_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=

# Clerk Auth (Required)
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Calendar (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Services
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=

# OAuth State Secret (Required for CSRF protection)
# Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=

# Encryption Key (Required for DSGVO at-rest encryption)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=