# --- Basis -------------------------------------------------------------------
# Ohne DATABASE_URL startet die App im Demo-Modus (eingebettete DB, Demo-Daten, kein Versand).
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Langer Zufallswert (z. B. `openssl rand -base64 48`) – signiert Links/Sessions, verschlüsselt Tokens
APP_SECRET=
# Schützt /api/cron (Vercel Cron sendet ihn automatisch als Bearer-Token)
CRON_SECRET=

# --- Admin-Login -------------------------------------------------------------
# Variante A: Supabase Auth (Nutzer muss zusätzlich in Tabelle `admins` stehen)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Variante B: einfacher Login per Umgebungsvariable
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- E-Mail (Resend) ---------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="[NAME] Boxing <buchung@deine-domain.de>"
TRAINER_NOTIFY_EMAIL=

# --- WhatsApp Business Cloud API -------------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_LANG=de

# --- Google Calendar ---------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary

# --- Stripe (optional) -------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
