{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["es2022", "dom", "dom.iterable"],
    "strict": true,
    "noEmit": true,
    "incremental": false,
    "jsx": "react-jsx",
    "allowJs": false,
    "resolveJsonModule": true,
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "src", "vitest.config.ts", "next.config.ts", ".next/types/**/*.ts", "scripts"],
  "exclude": ["node_modules"]
}
